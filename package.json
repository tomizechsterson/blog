{
  "name": "tomizechsterson-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "concurrently -n contentlayer,next -c cyan,magenta \"contentlayer2 dev\" \"next dev\"",
    "dev": "cross-env INIT_CWD=$PWD concurrently -n contentlayer,next -c cyan,magenta \"contentlayer2 dev\" \"next dev\"",
    "build": "contentlayer2 build && cross-env INIT_CWD=$PWD next build && cross-env NODE_OPTIONS='--experimental-json-modules' node ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "contentlayer2 build && cross-env ANALYZE=true next build --webpack",
    "lint": "contentlayer2 build && next typegen && eslint --fix . && tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "2.2.0",
    "@next/bundle-analyzer": "16.3.3",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.15",
    "@vercel/analytics": "^1.5.0",
    "body-scroll-lock": "^4.0.0-beta.0",
    "contentlayer2": "0.5.8",
    "esbuild": "0.25.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.2",
    "hast-util-from-html-isomorphic": "^2.0.0",
    "katex": "0.16.21",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "pliny": "0.4.1",
    "postcss": "^8.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.0",
    "rehype-katex": "^7.0.0",
    "rehype-katex-notranslate": "^1.1.4",
    "rehype-preset-minify": "7.0.0",
    "rehype-prism-plus": "^2.0.0",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.0",
    "remark-gfm": "^4.0.0",
    "remark-github-blockquote-alert": "^1.2.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.16.0",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/mdx": "^2.0.12",
    "@types/react": "^19.0.8",
    "@typescript-eslint/eslint-plugin": "^8.12.0",
    "@typescript-eslint/parser": "^8.12.0",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^15.12.0",
    "husky": "^9.0.0",
    "lint-staged": "^17.4.1",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "typescript": "^5.9"
  },
  "resolutions": {
    "@contentlayer2/cli": "0.5.8",
    "@contentlayer2/client": "0.5.8",
    "@contentlayer2/core": "0.5.8",
    "@contentlayer2/source-files": "0.5.8",
    "@contentlayer2/source-remote-files": "0.5.8",
    "@contentlayer2/utils": "0.5.8",
    "contentlayer2": "0.5.8",
    "glob": "^10.5.0",
    "uuid": "^11.1.1"
  },
  "lint-staged": {
    "*.+(js|jsx|mjs|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|mjs|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.9.4"
}
